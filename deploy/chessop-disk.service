# Mails the owner the df table when a filesystem is more than 80 % full (public spec §14).
# Started by chessop-disk.timer. No private /tmp or hidden /home, so df sees the real mounts.
[Unit]
Description=chessop disk check
ConditionPathExists=/opt/chessop/current/.venv/bin/chessop
OnFailure=chessop-notify@%n.service

[Service]
Type=oneshot
User=chessop
Group=chessop
EnvironmentFile=/etc/chessop/chessop.env
ExecStart=/usr/local/lib/chessop/disk-check
NoNewPrivileges=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
