#!/bin/sh
# Mail the owner that the unit named in $1 failed, with its status and last 50 journal lines
# (public spec §14). Run by chessop-notify@.service; installed by provision.sh in
# /usr/local/lib/chessop.
set -eu

unit=$1
chessop=/opt/chessop/current/.venv/bin/chessop

{
	# status exits non-zero for a failed unit, which is the point here
	systemctl status --no-pager --full --lines=0 "$unit" || true
	echo
	journalctl --unit="$unit" --lines=50 --no-pager --output=short-iso || true
} 2>&1 | "$chessop" notify-owner --subject "chessop: $unit failed on $(hostname)"
