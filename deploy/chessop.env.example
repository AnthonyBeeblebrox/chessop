# The hosted site's environment (public spec §1), read by chessop serve --hosted, chessop
# maintain and chessop notify-owner. provision.sh installs this file as /etc/chessop/chessop.env,
# root:chessop 0640, when none is there yet, and never overwrites it after that. Fill in the
# blanks there, on the VPS: no secret goes in the repository.

# The site's public address. Magic links, the Lichess client id, canonical links and link
# previews all use it, never a request's Host.
CHESSOP_BASE_URL=https://chessop.fr

# The database and its backups folder: the service's state directory.
CHESSOP_DATA_DIR=/var/lib/chessop

# The sender of sign-in emails, and where owner alerts (failures, disk, error digest) go.
CHESSOP_MAIL_FROM=login@chessop.fr
CHESSOP_OWNER_EMAIL=

# Scaleway Transactional Email (Paris). Required on an https base URL. Secret.
CHESSOP_TEM_SECRET_KEY=
CHESSOP_TEM_PROJECT_ID=

# The self-hosted GoatCounter. Unset: no analytics snippet.
CHESSOP_GOATCOUNTER_URL=https://stats.chessop.fr

# The off-site backup: the Scaleway Object Storage bucket in Paris, the access and secret key of
# the application allowed only to write objects to it (the secret key is a secret), and the
# owner's age public key (age1...) the backup is encrypted to. All four, or none to skip the
# upload.
CHESSOP_BACKUP_BUCKET=
CHESSOP_BACKUP_ACCESS_KEY=
CHESSOP_BACKUP_SECRET_KEY=
CHESSOP_BACKUP_RECIPIENT=
